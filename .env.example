# Cloudflare R2, where updates are published: the appcast and each release's DMG (under releases/).
# Copy this file to .env and fill in your values, or keep them in 1Password and use `op run`.
R2_ACCOUNT_ID=your_account_id_here
R2_BUCKET=hoverenhance
R2_APPCAST_PATH=appcast.xml
# The bucket's public address: a custom domain connected to it in Cloudflare.
APPCAST_BASE_URL=https://updates.example.com
